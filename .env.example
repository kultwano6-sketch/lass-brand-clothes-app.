# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for PayFast callbacks: return_url, cancel_url, and notify_url (ITN).
APP_URL="http://localhost:3000"

# PayFast Merchant Configuration (Keep server-side only; never expose to frontend)
# Sandbox defaults provided by PayFast for testing:
# Merchant ID: 10004002
# Merchant Key: q1cd2rdny4a53
# Passphrase: payfast
# Sandbox URL: https://sandbox.payfast.co.za/eng/process
PAYFAST_MERCHANT_ID="10004002"
PAYFAST_MERCHANT_KEY="q1cd2rdny4a53"
PAYFAST_PASSPHRASE="payfast"

# Set to "false" in production to connect to live PayFast (https://www.payfast.co.za)
PAYFAST_SANDBOX="true"
ALLOW_SANDBOX_SIMULATION="true"
