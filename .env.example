# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for PayFast callbacks: return_url, cancel_url, and notify_url (ITN).
APP_URL="http://localhost:3000"

# PayFast Merchant Configuration (Keep server-side only; never expose to frontend)
# LASS Merchant Account Credentials:
PAYFAST_MERCHANT_ID="10056107"
PAYFAST_MERCHANT_KEY="83lc36ab316ei"
# Set your salt passphrase if configured in PayFast Dashboard > Settings > Integration:
PAYFAST_PASSPHRASE="HARVEST KE LASS"

# Set to "true" for testing on PayFast Sandbox (https://sandbox.payfast.co.za)
PAYFAST_SANDBOX="true"
ALLOW_SANDBOX_SIMULATION="true"
