# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for PayFast callbacks: return_url, cancel_url, and notify_url (ITN).
APP_URL="http://localhost:3000"

# PayFast Merchant Configuration (Keep server-side only; never expose to frontend)
# Sandbox defaults provided by PayFast for testing:
# Merchant ID: 10000100
# Merchant Key: 46f0cd694581a
# Sandbox URL: https://sandbox.payfast.co.za/eng/process
PAYFAST_MERCHANT_ID="10000100"
PAYFAST_MERCHANT_KEY="46f0cd694581a"

# Optional security passphrase set in PayFast Dashboard -> Settings -> Security Passphrase
# Leave empty if not configured in your PayFast merchant account.
PAYFAST_PASSPHRASE=""

# Set to "false" in production to connect to live PayFast (https://www.payfast.co.za)
PAYFAST_SANDBOX="true"
